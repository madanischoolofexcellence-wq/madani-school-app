{
  "name": "madani-school-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Madani School of Excellence \u2014 Windows app (opens the live school system)",
  "author": "Madani School of Excellence",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "node-zklib": "^1.3.0"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.madani.schoolmgmt.desktop",
    "productName": "Madani School",
    "artifactName": "MadaniSchool-Setup.exe",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "offline.html",
      "build/icon.png",
      "package.json",
      "bridge.js",
      "zkbio.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Madani School",
      "differentialPackage": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/madanischoolofexcellence-wq/madani-school-app/releases/latest/download"
      }
    ]
  }
}
